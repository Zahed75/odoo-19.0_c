<templates>
    <!-- Search bar - Enterprise Style Centered -->
    <t t-name="web_responsive.AppsMenuCanonicalSearchBar">
        <div class="search-container" t-att-class="{'has-results': state.hasResults}">
            <div class="search-input">
                <span class="search-slash">/</span>
                <input
                    type="search"
                    t-ref="SearchBarInput"
                    t-on-input="_searchMenus"
                    t-on-keydown="_onKeyDown"
                    autocomplete="off"
                    placeholder="Search for a menu..."
                    class="form-control"
                />
                <i class="oi oi-search search-icon" />
            </div>
            <ul
                t-if="hasItemsToDisplay"
                class="list-unstyled search-list"
                t-ref="searchItems"
            >
                <!-- Apps Category -->
                <li t-if="state.rootItems.length" class="search-category">
                    <span class="search-category-label">Apps</span>
                </li>
                <t t-foreach="state.rootItems" t-as="menu" t-key="menu.id">
                    <li t-attf-class="search-item {{highlighted(menu_index)}}">
                        <a
                            t-attf-class="search-item__link"
                            t-att-href="menu.path"
                            t-att-data-menu-id="menu.id"
                            t-att-data-action-id="menu.actionID"
                            draggable="false"
                            tabindex="-1"
                        >
                            <div class="search-item__icon-wrapper">
                                <img
                                    t-if="menu.webIconData"
                                    class="search-item__image"
                                    t-att-src="menu.webIconData"
                                    alt="App Icon"
                                />
                                <div
                                    t-elif="menu.webIconObject"
                                    class="search-item__image d-flex align-items-center justify-content-center"
                                    t-attf-style="background-color:{{menu.webIconObject.backgroundColor}}"
                                >
                                    <i t-att-class="menu.webIconObject.iconClass" t-attf-style="color:{{menu.webIconObject.color}}" />
                                </div>
                                <div t-else="" class="search-item__icon-fallback">
                                    <i class="fa fa-th-large" />
                                </div>
                            </div>
                            <span class="search-item__name" t-att-title="menu.name">
                                <t
                                    t-foreach="_splitName(menu.displayName)"
                                    t-as="name"
                                    t-key="name_index"
                                >
                                    <b t-if="name_index % 2" t-out="name" />
                                    <t t-else="" t-out="name" />
                                </t>
                            </span>
                            <span class="search-item__shortcut ms-auto">
                                <t t-if="menu.actionPath">
                                    <kbd>CMD</kbd> + <kbd>↵</kbd> <span class="shortcut-label">new tab</span>
                                </t>
                            </span>
                        </a>
                    </li>
                </t>
                <!-- Menu Items Category -->
                <li t-if="state.subItems.length" class="search-category">
                    <span class="search-category-label">Menu Items</span>
                </li>
                <t t-foreach="state.subItems" t-as="menu" t-key="menu.id">
                    <li t-attf-class="search-item {{highlighted(menu_index, true)}}">
                        <a
                            t-attf-class="search-item__link"
                            t-att-href="menu.path"
                            t-att-data-menu-id="menu.id"
                            t-att-data-action-id="menu.actionID"
                            draggable="false"
                            tabindex="-1"
                        >
                            <span
                                class="search-item__name px-2 py-1"
                                t-att-title="menu.name"
                            >
                                <t
                                    t-foreach="_splitName(menu.displayName)"
                                    t-as="name"
                                    t-key="name_index"
                                >
                                    <b t-if="name_index % 2" t-out="name" />
                                    <t t-else="" t-out="name" />
                                </t>
                            </span>
                        </a>
                    </li>
                </t>
            </ul>
            <ul
                t-if="!hasItemsToDisplay and inputValue"
                class="list-unstyled search-list"
            >
                <li class="empty-search-item">
                    <strong>No menu found</strong>
                </li>
            </ul>
            <!-- Footer tip like Enterprise -->
            <div t-if="state.hasResults" class="search-footer">
                <span class="search-footer-tip">TIP — open me anywhere with <strong>COMMAND + K</strong></span>
            </div>
        </div>
    </t>
</templates>
