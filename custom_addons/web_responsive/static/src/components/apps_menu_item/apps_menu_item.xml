<templates>
    <t t-name="web_responsive.AppMenuItem">
        <a
            t-att-class="className"
            role="button"
            t-att-data-menu-xmlid="props.app.xmlid"
            t-att-href="props.href"
            t-on-click="onClick"
            draggable="false"
        >
            <div
                class="position-relative o_app"
                t-att-data-menu-xmlid="props.app.xmlid"
            >
                <!-- If we have image data (webIconData or file path) -->
                <img
                    t-if="webIconData"
                    class="o-app-menu-item__icon rounded-3"
                    draggable="false"
                    t-att-src="webIconData"
                />
                <!-- If we have a webIcon with 3 parts (iconClass, color, backgroundColor) -->
                <div
                    t-elif="webIconObject"
                    class="o-app-menu-item__icon rounded-3 d-flex align-items-center justify-content-center"
                    t-attf-style="background-color:{{webIconObject.backgroundColor}}"
                >
                    <i t-att-class="webIconObject.iconClass" t-attf-style="color:{{webIconObject.color}}; font-size: 1.5rem;" />
                </div>
                <!-- Fallback default icon -->
                <img
                    t-else=""
                    class="o-app-menu-item__icon rounded-3"
                    draggable="false"
                    src="/web_responsive/static/img/default_icon_app.png"
                />
                <i t-if="isActive" class="fa fa-check-circle o-app-menu-item__active" />
            </div>
            <span class="o-app-menu-item__name" t-att-title="props.app.name">
                <t t-out="props.app.name" />
            </span>
        </a>
    </t>
</templates>
