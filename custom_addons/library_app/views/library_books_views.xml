<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <!--  List View  -->


    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books" decoration-muted="state == 'lost'" decoration-danger="copies_available == 0">
                <field name="name"/>
                <field name="author_id"/>
                <field name="category"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="isbn" optional="hide"/>
                <field name="price" optional="show"/>
                <field name="currency_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="copies_available" sum="Available"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'lost'"/>

            </list>
        </field>

    </record>


    <!--   Form View  -->

    <record id="library_book_form_view" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_make_available" string="Make Available" type="object" class="btn-primary"
                            invisible="state !='draft'"/>

                    <button name="action_mark_lost" string="Mark As Lost" type="object"
                            invisible="state =='lost'" confirm="Are You Sure?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,available,lost"/>

                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <field name="cover" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g Clean Code"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General">
                            <field name="author_id"/>
                            <field name="isbn"/>
                            <field name="category"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>

                    <group string="Stock &amp; Price">
                        <field name="copies_total"/>
                        <field name="copies_available"/>
                        <field name="price"/>
                        <field name="currency_id"/>
                        <field name="published_date"/>
                        <field name="pages"/>
                        <field name="active" invisible="1"/>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>

                        <page string="Loan History" name="loans">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="member_id"/>
                                    <field name="loan_date"/>
                                    <field name="state"/>
                                </list>

                            </field>
                        </page>

                    </notebook>

                </sheet>

                <chatter/>


            </form>
        </field>
    </record>


    <!-- Kanban View   -->

    <record id="library_book_view_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="name"/>
                <field name="cover"/>
                <field name="author_id"/>
                <field name="tag_ids"/>
                <field name="copies_available"/>
                <field name="state"/>
                <field name="isbn"/>
                <field name="price"/>
                <field name="published_date"/>
                <field name="category"/>

                <templates>
                    <t t-name="card">
                        <div class="position-relative border rounded-3 bg-white shadow-sm overflow-hidden"
                            style="min-height: 220px;">

                            <!-- Price Ribbon -->
                            <div class="position-absolute"
                                style="top: 14px; right: -30px; width: 120px;
                                        transform: rotate(45deg); z-index: 2;
                                        text-align: center;">

                                <span t-if="record.price.raw_value &lt; 300"
                                    class="d-block bg-success text-white fw-bold py-1">
                                    <field name="price" widget="monetary"/>
                                </span>

                                <span t-elif="record.price.raw_value &lt; 800"
                                    class="d-block bg-primary text-white fw-bold py-1">
                                    <field name="price" widget="monetary"/>
                                </span>

                                <span t-else=""
                                    class="d-block bg-danger text-white fw-bold py-1">
                                    <field name="price" widget="monetary"/>
                                </span>
                            </div>

                            <!-- Main Content -->
                            <div class="d-flex gap-3 p-3">

                                <!-- Book Cover -->
                                <div class="flex-shrink-0">
                                    <field name="cover"
                                        widget="image"
                                        options="{'size': [100, 130]}"/>
                                </div>

                                <!-- Book Details -->
                                <div class="flex-grow-1" style="min-width: 0;">

                                    <div class="fw-bold fs-5 mb-2"
                                        style="line-height: 1.3;">
                                        <field name="name"/>
                                    </div>

                                    <div class="text-muted mb-2">
                                        <i class="fa fa-user me-1"/>
                                        <field name="author_id"/>
                                    </div>

                                    <div class="mb-2">
                                        <field name="tag_ids"
                                            widget="many2many_tags"
                                            options="{'color_field': 'color'}"/>
                                    </div>

                                    <div class="small text-muted mb-1">
                                        <i class="fa fa-barcode me-1"/>
                                        <span>ISBN: </span>
                                        <field name="isbn"/>
                                    </div>

                                    <div class="small text-muted mb-1">
                                        <i class="fa fa-calendar me-1"/>
                                        <span>Published: </span>
                                        <field name="published_date"/>
                                    </div>

                                    <div class="small text-muted">
                                        <i class="fa fa-folder me-1"/>
                                        <field name="category"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="d-flex align-items-center justify-content-between
                                        border-top bg-light px-3 py-2">

                                <div class="small">
                                    <i class="fa fa-book me-1"/>
                                    <span class="text-muted">Available: </span>
                                    <strong>
                                        <field name="copies_available"/>
                                    </strong>
                                </div>

                                <field name="state"
                                    widget="label_selection"
                                    options="{
                                        'classes': {
                                            'draft': 'default',
                                            'available': 'success',
                                            'lost': 'danger'
                                        }
                                    }"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>



    <!--  Search View  -->


    <!--    Pivot View-->


    <!--    Graph View -->


    <!--  Action View  -->


    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_available':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first book</p>
            <p>Books You add here can be lent to library members</p>
        </field>
    </record>

</odoo>